NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/otaway?schema=public
APP_BASE_URL=http://localhost:3001

OAUTH_PROVIDER_NAME=Keycloak
OAUTH_AUTHORIZATION_URL=http://localhost:8081/realms/otaway/protocol/openid-connect/auth
OAUTH_TOKEN_URL=http://localhost:8081/realms/otaway/protocol/openid-connect/token
OAUTH_REVOCATION_URL=http://localhost:8081/realms/otaway/protocol/openid-connect/revoke
OAUTH_JWKS_URL=http://localhost:8081/realms/otaway/protocol/openid-connect/certs
OAUTH_ISSUER=http://localhost:8081/realms/otaway
OAUTH_CLIENT_ID=replace-with-your-web-client-id
OAUTH_CLIENT_SECRET=replace-with-your-web-client-secret
OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
OAUTH_MOBILE_CLIENT_ID=replace-with-your-mobile-client-id
OAUTH_SCOPE=openid email profile offline_access
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/

SESSION_SECRET=replace-with-at-least-32-random-characters
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
BYPASS_AUTH=false
BYPASS_ACCESS_CONTROL=false